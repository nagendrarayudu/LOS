generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Chart of Accounts (GL) ────────────────────────────────
// Bank-wide GL account tree (main group → sub group → posting-group leaf), seeded from the
// BIAB CBS chart-of-accounts reference. BIAB is single-tenant (one core-banking instance),
// unlike LOS, so there's no Tenant model here.

enum GLAccountClass {
  ASSETS
  LIABILITIES
  EQUITY
  INCOME
  EXPENSES
  CONTINGENT
}

model GLAccount {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  cls           GLAccountClass
  level         Int // 1 = main group, 2 = sub group, 3 = posting group (leaf)
  parentId      String?
  parent        GLAccount?     @relation("GLAccountChildren", fields: [parentId], references: [id])
  children      GLAccount[]    @relation("GLAccountChildren")
  isLeaf        Boolean        @default(false) // leaf accounts are where GL postings actually land
  normalBalance String? // Dr | Cr
  currency      String? // ZWG | USD | Multi
  mapLabel      String? // financial-statement line item this account rolls up to (e.g. "SOFP - Cash & bank balances")
  subGroup      String?
  notes         String?
  rangeFrom     String?
  rangeTo       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
