DATABASE_URL="postgresql://los:los@localhost:5432/sahyog_los?schema=public"
PORT=4000
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"

# Aadhaar OTP-consent eKYC — "mock" needs no credentials and works out of the box.
# Set to a vendor name (e.g. "signzy", "scoreme") + the two vars below once you have an
# account; see backend/src/services/aadhaarEkyc.ts for what needs verifying against the
# vendor's actual API docs before this is production-ready.
AADHAAR_EKYC_PROVIDER="mock"
# AADHAAR_EKYC_BASE_URL="https://api.example-vendor.com"
# AADHAAR_EKYC_API_KEY=""

# Signzy DigiLocker consent eKYC (see backend/src/services/signzyDigilocker.ts) — built
# against Signzy's documented /api/v3/digilocker/createUrl request/webhook shapes. Needs
# all three vars below, and PUBLIC_APP_URL / PUBLIC_API_URL must be real internet-reachable
# HTTPS URLs (e.g. an ngrok tunnel in local dev) since Signzy calls your webhook directly —
# leave unset to disable this option (the KYC step just won't show the DigiLocker button).
# SIGNZY_API_TOKEN=""
# SIGNZY_BASE_URL="https://api-preproduction.signzy.app"
# PUBLIC_APP_URL="https://your-frontend.example.com"
# PUBLIC_API_URL="https://your-backend.example.com"
