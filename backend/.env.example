# Aadhaar OTP-consent eKYC — "mock" needs no credentials and works out of the box.
# Set to a vendor name (e.g. "signzy", "scoreme") + the two vars below once you have an
# account; see backend/src/services/aadhaarEkyc.ts for what needs verifying against the
# vendor's actual API docs before this is production-ready.
AADHAAR_EKYC_PROVIDER="mock"
# AADHAAR_EKYC_BASE_URL="https://api.example-vendor.com"
# AADHAAR_EKYC_API_KEY=""
