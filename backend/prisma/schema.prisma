generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy ──────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users        StaffUser[]
  customers    Customer[]
  schemes      Scheme[]
  applications LoanApplication[]
}

// ── Staff / auth ─────────────────────────────────────────

enum StaffRole {
  ADMIN
  LOAN_OFFICER // maker
  MANAGER // checker / branch head
  COMMITTEE_MEMBER
  DISBURSAL_OFFICER
}

model StaffUser {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  name           String
  email          String    @unique
  passwordHash   String
  role           StaffRole
  branch         String?
  approvalLimit  Decimal?  @db.Decimal(14, 2)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  assignedApplications  LoanApplication[]        @relation("AssignedOfficer")
  statusChanges         ApplicationStatusEvent[]
  sanctionDecisions     SanctionDecision[]
  disbursals            Disbursal[]
  documentVerifications Document[]
}

// ── Customers ────────────────────────────────────────────

model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  mobile            String
  name              String?
  email             String?
  dob               DateTime?
  gender            String?
  panNumber         String?
  panVerifiedAt     DateTime?
  aadhaarLast4      String?
  aadhaarVerifiedAt DateTime?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  occupation        String?
  employer          String?
  netIncome         Decimal?  @db.Decimal(14, 2)
  cibilScore        Int?
  hasActiveDefault  Boolean   @default(false)
  preferredLanguage String    @default("en")
  kycVerifiedAt     DateTime?
  createdAt         DateTime  @default(now())

  applications LoanApplication[]

  @@unique([tenantId, mobile])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  mobile     String
  otpHash    String
  purpose    String // LOGIN | MOBILE_VERIFY
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Aadhaar OTP-consent eKYC (Signzy/ScoreMe-style: generate-otp -> verify-otp -> demographic data).
// `provider` records which backend actually served the request so real vendor calls and the
// local demo fallback are distinguishable in the data, not just in code.
model AadhaarEkycChallenge {
  id            String    @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  aadhaarNumber String
  provider      String // mock | signzy | scoreme
  providerRef   String // opaque reference/transaction id returned by generate-otp
  otpHash       String? // only set for the mock provider, which owns its own OTP
  attempts      Int       @default(0)
  expiresAt     DateTime
  verifiedAt    DateTime?
  resultJson    Json? // demographic payload once verified
  createdAt     DateTime  @default(now())
}

// Signzy DigiLocker consent flow: createUrl -> customer completes consent on DigiLocker's
// own site -> Signzy POSTs the result to our webhook, matched back here by requestId.
model DigilockerRequest {
  id            String    @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  requestId     String    @unique
  status        String    @default("pending") // pending | success | failure
  resultJson    Json?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

// ── Schemes ──────────────────────────────────────────────

enum SchemeCategory {
  SECURED
  UNSECURED
}

enum RepaymentType {
  REDUCING
  BULLET
}

model Scheme {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  key               String // gold | personal | msme | housing | lap | vehicle
  name              String
  category          SchemeCategory
  repaymentType     RepaymentType  @default(REDUCING)
  interestRate      Decimal        @db.Decimal(5, 2)
  minAmount         Decimal        @db.Decimal(14, 2)
  maxAmount         Decimal        @db.Decimal(14, 2)
  minTenureMonths   Int
  maxTenureMonths   Int
  ltvPercent        Decimal?       @db.Decimal(5, 2)
  tag               String?
  description       String?
  active            Boolean        @default(true)

  applications LoanApplication[]

  @@unique([tenantId, key])
}

// ── Applications ─────────────────────────────────────────

enum ApplicationStatus {
  DRAFT
  NEW_LEAD
  DOCS_PENDING
  MAKER_REVIEW
  COMMITTEE_REVIEW
  SANCTIONED
  DISBURSED
  REJECTED
}

enum ApplicantType {
  INDIVIDUAL
  ENTERPRISE
}

model LoanApplication {
  id                 String            @id @default(cuid())
  applicationNumber  String            @unique
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id])
  schemeId           String
  scheme             Scheme            @relation(fields: [schemeId], references: [id])
  applicantType      ApplicantType     @default(INDIVIDUAL)
  requestedAmount    Decimal           @db.Decimal(14, 2)
  tenureMonths       Int
  purpose            String?
  collateralValue    Decimal?          @db.Decimal(14, 2)
  status             ApplicationStatus @default(DRAFT)
  branch             String?
  assignedOfficerId  String?
  assignedOfficer    StaffUser?        @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])

  // Computed at submission from loanMath.ts
  emi                 Decimal? @db.Decimal(14, 2)
  aprPercent          Decimal? @db.Decimal(5, 2)
  processingFeeAmount Decimal? @db.Decimal(14, 2)
  totalInterest       Decimal? @db.Decimal(14, 2)
  totalPayable        Decimal? @db.Decimal(14, 2)
  netDisbursedAmount  Decimal? @db.Decimal(14, 2)
  kfsAcceptedAt       DateTime?

  compositeScore     Int?
  autoRecommendation String? // APPROVE | REVIEW
  rejectionReason    String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  documents         Document[]
  statusEvents      ApplicationStatusEvent[]
  scoreComponents   CreditScoreComponent[]
  policyChecks      PolicyCheck[]
  sanctionDecisions SanctionDecision[]
  disbursal         Disbursal?
  aadhaarEkycChallenges AadhaarEkycChallenge[]
  digilockerRequests    DigilockerRequest[]
}

model ApplicationStatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   LoanApplication   @relation(fields: [applicationId], references: [id])
  status        ApplicationStatus
  note          String?
  actorId       String?
  actor         StaffUser?        @relation(fields: [actorId], references: [id])
  createdAt     DateTime          @default(now())
}

model Document {
  id            String          @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  type          String // doc code from documents.ts DOC_LIBRARY
  fileName      String
  fileUrl       String
  uploadedAt    DateTime        @default(now())
  verified      Boolean         @default(false)
  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    StaffUser?      @relation(fields: [verifiedById], references: [id])
}

model CreditScoreComponent {
  id            String          @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  component     String // CIBIL_SCORE, BEHAVIOUR, TRANSACTIONAL, BANK_STATEMENT, REPAYMENT_HISTORY, DEFAULT_HISTORY, AGE_SUITABILITY, EMPLOYER_CATEGORY, CO_APPLICANT
  weightPercent Int
  score         Int // 0-100
  note          String?
}

model PolicyCheck {
  id            String          @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id])
  name          String
  passed        Boolean
  note          String?
  checkedAt     DateTime        @default(now())
}

// ── Maker-checker / committee sanction workflow ──────────

enum SanctionLevel {
  MAKER
  CHECKER
  COMMITTEE
}

enum SanctionDecisionType {
  RECOMMENDED
  APPROVED
  REJECTED
  RETURNED
}

model SanctionDecision {
  id                     String               @id @default(cuid())
  applicationId          String
  application            LoanApplication      @relation(fields: [applicationId], references: [id])
  level                  SanctionLevel
  decidedById            String
  decidedBy              StaffUser            @relation(fields: [decidedById], references: [id])
  decision               SanctionDecisionType
  sanctionedAmount       Decimal?             @db.Decimal(14, 2)
  sanctionedTenureMonths Int?
  sanctionedRate         Decimal?             @db.Decimal(5, 2)
  remarks                String?
  decidedAt              DateTime             @default(now())
}

// ── Disbursal ────────────────────────────────────────────

enum DisbursalMethod {
  CBS
  NEFT
}

enum DisbursalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PennyDropStatus {
  PENDING
  VERIFIED
  FAILED
}

model Disbursal {
  id                String          @id @default(cuid())
  applicationId     String          @unique
  application       LoanApplication @relation(fields: [applicationId], references: [id])
  method            DisbursalMethod
  amount            Decimal         @db.Decimal(14, 2)
  accountNumber     String
  ifsc              String
  beneficiaryName   String
  utrReference      String?
  pennyDropStatus   PennyDropStatus @default(PENDING)
  pennyDropAttempts Int             @default(0)
  neftFileGenerated Boolean         @default(false)
  status            DisbursalStatus @default(PENDING)
  disbursedById     String?
  disbursedBy       StaffUser?      @relation(fields: [disbursedById], references: [id])
  disbursedAt       DateTime?
  createdAt         DateTime        @default(now())
}
